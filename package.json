{
  "name": "leetcode-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "Personal LeetCode study repository using JavaScript and Node.js.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run-root-tests.js",
    "test:watch": "node scripts/run-root-tests.js --watch",
    "test:coverage": "node scripts/run-root-tests.js --coverage",
    "test:exercise": "node scripts/run-exercise.js",
    "new:exercise": "node scripts/new-exercise.js",
    "validate": "node scripts/validate.js && node scripts/run-root-tests.js",
    "reference:dev": "npm --prefix apps/javascript-reference run dev",
    "reference:build": "npm --prefix apps/javascript-reference run build",
    "reference:test": "npm --prefix apps/javascript-reference run test",
    "reference:typecheck": "npm --prefix apps/javascript-reference run typecheck",
    "reference:lint": "npm --prefix apps/javascript-reference run lint",
    "reference:test:e2e": "npm --prefix apps/javascript-reference run test:e2e"
  }
}
